<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<appSettings>
		<!-- WebSocket Server URL -->
		<add key="WebSocketUrl" value="ws://localhost:2050" />
		<!-- Client Name - Used to identify each client computer (e.g., PC1, PC2, PC3, etc.) -->
		<!-- This name will be displayed in the server UI so the operator knows which computer is being managed -->
		<add key="ClientName" value="PC1" />
	</appSettings>
</configuration>